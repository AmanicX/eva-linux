#!/usr/bin/env bash
# Toggle the Quickshell keybind cheatsheet, regenerating data first.
set -Eeuo pipefail

if command -v eva-keybinds-manager >/dev/null 2>&1; then
    GENERATOR="eva-keybinds-manager"
elif [[ -x "/usr/share/eva/keybinds/gen-keybinds.py" ]]; then
    GENERATOR="/usr/share/eva/keybinds/gen-keybinds.py"
elif [[ -x "/usr/share/astra/keybinds/gen-keybinds.py" ]]; then
    GENERATOR="/usr/share/astra/keybinds/gen-keybinds.py"
else
    SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" 2>/dev/null && pwd -P)"
    GENERATOR="${SCRIPT_DIR}/eva-keybinds-manager"
fi

if [[ -n "${GENERATOR:-}" ]]; then
    "$GENERATOR" >/dev/null 2>&1 || true
fi

QS_CMD="quickshell"
command -v qs >/dev/null 2>&1 && QS_CMD="qs"

if ${QS_CMD} ipc -c keybinds call keybinds toggle >/dev/null 2>&1; then
    exit 0
fi

${QS_CMD} -c keybinds -d >/dev/null 2>&1 || true

for _ in {1..60}; do
    if ${QS_CMD} ipc -c keybinds call keybinds open >/dev/null 2>&1; then
        exit 0
    fi
    sleep 0.05
done

exit 1
