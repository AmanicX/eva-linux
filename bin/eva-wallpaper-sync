#!/usr/bin/env python3
"""Synchronize Noctalia wallpaper to configured SDDM and GRUB themes."""

import sys
import os
import time
import argparse
import io
import subprocess
import tomllib

DEFAULT_WALLPAPER = os.path.expanduser("~/Pictures/Wallpapers/eva-crimson-temple.jpg")
NOCTALIA_SETTINGS = os.path.expanduser("~/.local/state/noctalia/settings.toml")
SDDM_THEME_DIR = "/usr/share/sddm/themes/silent"
GRUB_THEME_DIR = "/boot/grub/themes/hyperfluent"
INSTALL_HELPER = "/usr/local/libexec/eva-wallpaper-install"

def get_noctalia_wallpaper():
    """Retrieve current wallpaper from Noctalia CLI or settings.toml."""
    # Try noctalia msg wallpaper-get
    try:
        res = subprocess.run(["noctalia", "msg", "wallpaper-get"], capture_output=True, text=True, timeout=2)
        if res.returncode == 0 and res.stdout.strip():
            wp = res.stdout.strip()
            if os.path.isfile(wp):
                return wp
    except (OSError, subprocess.TimeoutExpired):
        pass

    # Try reading settings.toml
    if os.path.isfile(NOCTALIA_SETTINGS):
        try:
            with open(NOCTALIA_SETTINGS, "r", encoding="utf-8") as f:
                wallpaper = tomllib.loads(f.read()).get("wallpaper", {})
            for key in ("default", "last"):
                raw_path = wallpaper.get(key, {}).get("path", "")
                expanded = os.path.expanduser(raw_path)
                if os.path.isfile(expanded):
                    return expanded
        except (OSError, tomllib.TOMLDecodeError):
            pass

    return DEFAULT_WALLPAPER if os.path.isfile(DEFAULT_WALLPAPER) else None

def install_image(wallpaper_path, target):
    """Decode as the user; send only encoded bytes to the fixed-target helper."""
    try:
        from PIL import Image, ImageOps

        with Image.open(wallpaper_path) as image:
            if image.width * image.height > 36_000_000:
                raise ValueError("Wallpaper exceeds the 36 megapixel input limit")
            image = ImageOps.exif_transpose(image).convert("RGB")
            image.thumbnail((3840, 2160))
            encoded = io.BytesIO()
            image.save(encoded, "JPEG" if target == "sddm" else "PNG")
        result = subprocess.run(
            ["sudo", "-n", INSTALL_HELPER, target],
            input=encoded.getvalue(), capture_output=True, timeout=30,
        )
        if result.returncode:
            return False, result.stderr.decode(errors="replace").strip() or "Image installation refused"
        return True, "Wallpaper synchronized (no bootloader configuration rebuild)"
    except (ImportError, OSError, ValueError, subprocess.TimeoutExpired) as error:
        return False, str(error)


def sync_sddm(wallpaper_path):
    if not os.path.isfile(f"{SDDM_THEME_DIR}/configs/eva.conf"):
        return None, "Eva SilentSDDM preset not configured; skipped"
    return install_image(wallpaper_path, "sddm")


def sync_grub(wallpaper_path):
    if not os.path.isfile(f"{GRUB_THEME_DIR}/theme.txt"):
        return None, "HyperFluent GRUB theme not configured; skipped"
    return install_image(wallpaper_path, "grub")

def sync_all(wallpaper_path=None):
    """Run full synchronization."""
    wp = wallpaper_path or get_noctalia_wallpaper()
    if not wp or not os.path.isfile(wp):
        print("Error: Could not locate a valid wallpaper to synchronize.", file=sys.stderr)
        return 1

    print(f"✦ Eva Linux Wallpaper Sync: {wp}")
    sddm_ok, sddm_msg = sync_sddm(wp)
    print(f"  [SDDM] {'skip' if sddm_ok is None else '✓' if sddm_ok else '✗'} {sddm_msg}")

    grub_ok, grub_msg = sync_grub(wp)
    print(f"  [GRUB] {'skip' if grub_ok is None else '✓' if grub_ok else '✗'} {grub_msg}")

    return 1 if sddm_ok is False or grub_ok is False else 0

def watch_mode():
    """Watch Noctalia settings file for wallpaper changes and sync automatically."""
    print("✦ Eva Linux Wallpaper Watcher active. Monitoring Noctalia settings...")
    last_signature = None
    retry_after = 0

    while True:
        try:
            current_wp = get_noctalia_wallpaper()
            if current_wp and time.monotonic() >= retry_after:
                settings_mtime = os.path.getmtime(NOCTALIA_SETTINGS) if os.path.isfile(NOCTALIA_SETTINGS) else 0
                signature = (current_wp, os.path.getmtime(current_wp), settings_mtime)
                if signature != last_signature:
                    if sync_all(current_wp) == 0:
                        last_signature = signature
                    else:
                        retry_after = time.monotonic() + 30
        except Exception as e:
            print(f"Watcher error: {e}", file=sys.stderr)
        time.sleep(3)

def main():
    parser = argparse.ArgumentParser(description="Eva Linux v2 Wallpaper Synchronizer")
    parser.add_argument("wallpaper", nargs="?", default=None, help="Path to wallpaper image (optional)")
    parser.add_argument("--watch", action="store_true", help="Run in continuous background watcher mode")
    args = parser.parse_args()

    if args.watch:
        watch_mode()
    else:
        sys.exit(sync_all(args.wallpaper))

if __name__ == "__main__":
    main()
